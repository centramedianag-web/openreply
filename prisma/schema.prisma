// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  aiReplies         AiReply[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

/// aiEnabled / aiBrain sit on the account rather than the campaign because the
/// brand voice and the facts belong to the client, not to one automation. A
/// workspace running five clients keeps five separate brains, and one client's
/// pricing can never leak into another's reply.
model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  /// Off by default. An account only starts replying with AI once someone has
  /// written a brain for it and turned this on deliberately.
  aiEnabled         Boolean  @default(false)
  /// Separate from aiEnabled, and separately off by default. A DM is private
  /// and reversible in practice; a comment reply is published under the
  /// client's name where their whole audience sees it. That is a bigger step
  /// than turning on DM replies, so it is never implied by it.
  aiCommentsEnabled Boolean  @default(false)
  /// What the model is allowed to know about this client: who they are, what
  /// they sell, tone, and what to do with enquiries it must not answer.
  aiBrain           String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  aiReplies   AiReply[]
  intentAssets AiIntentAsset[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  // dmMessage is the single source of truth when dmMessages is empty. When the
  // pool has entries one is picked at random per send, so a campaign firing
  // hundreds of times does not put the identical string in hundreds of inboxes
  // — the pattern Instagram's spam heuristics look for. Mirrors
  // publicReplyMessage / publicReplyMessages.
  dmMessage      String
  dmMessages     String[] @default([])
  // Publicly reachable PNG/JPEG (Meta fetches it server-side, 8MB cap) sent as
  // a second message after the DM text. Only on paths that use a real DM
  // (button-tap reveal, DM keyword trigger) — a private reply to a comment is
  // documented as text-only and is capped at one message per comment.
  dmImageUrl     String?
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  steps            AutomationStep[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

/// One screen of a branching DM menu: some text, optionally some images, and
/// the buttons under it.
///
/// Steps are additive — a campaign with no steps behaves exactly as it did
/// before, running the flat dmMessage path. A campaign with steps sends its
/// entry step instead, and every button tap after that lands back here.
///
/// The graph is deliberately not validated into a tree. Menus loop: every leaf
/// in the Chokar Dhani flow ends with a "back" button pointing at the menu that
/// opened it, and a cycle is the correct shape for that, not a bug.
model AutomationStep {
  id           String @id @default(cuid())
  automationId String

  /// Shown only in the builder, so an editor can tell two menus apart.
  name String?
  /// The message body. Merge tags ({{first_name}}) are substituted at send
  /// time — see lib/dm/merge-tags.ts.
  text String
  /// Sent as separate image messages before the text, in order. Meta fetches
  /// each URL server-side, so they must be publicly reachable (8MB, PNG/JPEG).
  /// A list rather than a single URL because a rate card and a menu card are
  /// two images answering one question.
  imageUrls String[] @default([])
  /// Pause before this step is delivered. Seconds, not minutes, because the
  /// flows worth mirroring use 7s "typing" beats as well as longer waits;
  /// followUpDelayMinutes could not express either.
  delaySeconds Int @default(0)

  /// The step a campaign opens with. Exactly one per automation, enforced by
  /// the partial unique index in the migration rather than in application code.
  isEntry Boolean @default(false)

  /// Deliver this step next, without waiting for a tap.
  ///
  /// Buttons cover branching; this covers sequence. A flow that says something,
  /// pauses, then says the phone number is one thought delivered as two
  /// messages — there is no choice to make, so asking the reader to press
  /// something would be wrong. Combined with the next step's delaySeconds it
  /// reproduces the timed beats real flows are written with.
  ///
  /// SetNull rather than Cascade: losing the follow-up should end the sequence,
  /// not delete the message that came before it.
  nextStepId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automation   Automation             @relation(fields: [automationId], references: [id], onDelete: Cascade)
  next         AutomationStep?        @relation("StepChain", fields: [nextStepId], references: [id], onDelete: SetNull)
  previous     AutomationStep[]       @relation("StepChain")
  intentAssets AiIntentAsset[]
  buttons      AutomationStepButton[] @relation("StepButtons")
  /// Buttons elsewhere in the flow that point at this step. Named so the
  /// cascade is explicit: deleting a step deletes the buttons leading to it,
  /// which is what stops a tap from resolving to nothing.
  incoming   AutomationStepButton[] @relation("ButtonTarget")

  @@index([automationId])
}

/// Answer a recognised intent with a prepared step instead of the model's own
/// words.
///
/// This exists for one case and generalises from it. The assistant is forbidden
/// from stating a price, so "what's the entry fee?" gets a phone number — worse
/// than the keyword bot it replaced, which answered instantly with a rate card.
/// Mapping the "pricing" intent to a step sends that same rate card, except now
/// it fires on any phrasing in any language rather than on ten guessed keywords.
///
/// The figure still never comes from the model. It comes from artwork the
/// client publishes and reissues, which is where a price that has to stay
/// current belongs.
model AiIntentAsset {
  id                 String @id @default(cuid())
  instagramAccountId String
  /// A SmartReplyIntent value. Deliberately a string, not an enum: the model's
  /// intent list changes with the prompt, and a migration per new intent would
  /// mean the prompt and the database have to ship together.
  intent String
  stepId String

  createdAt DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  step             AutomationStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, intent])
  @@index([stepId])
}

/// A button under a step. Either it opens a URL or it moves to another step —
/// never both, and never neither.
///
/// Meta's button template allows at most 3 buttons with 20-char titles; both
/// caps are applied at send time rather than trusted here, so an over-long
/// label degrades to a truncated button instead of a failed send.
model AutomationStepButton {
  id     String @id @default(cuid())
  stepId String

  label String
  /// Set for a navigation button. The postback payload is `step:<targetStepId>`
  /// — the step id alone, because a cuid is already globally unique and
  /// carrying the automation id as well would only add a second thing to keep
  /// in sync.
  targetStepId String?
  /// Set for a link button. Point this at a TrackedLink slug rather than the
  /// destination directly when the click matters.
  url String?

  sort Int @default(0)

  step   AutomationStep  @relation("StepButtons", fields: [stepId], references: [id], onDelete: Cascade)
  target AutomationStep? @relation("ButtonTarget", fields: [targetStepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([targetStepId])
}

/// One row per inbound DM the AI answered.
///
/// Kept apart from DmLog because that table hangs off an Automation and dedupes
/// on [automationId, commentId]; an AI reply belongs to no campaign. The row is
/// written BEFORE the send, so a retried job hits the unique messageId and stops
/// instead of messaging the person twice.
model AiReply {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  /// The Meta id of whatever is being answered: a message id for a DM, a
  /// comment id for a public reply. Both come from the same id space, so one
  /// unique column safely dedupes both. The column keeps its original name so
  /// that adding comments needed no data migration.
  sourceId     String  @unique @map("messageId")
  /// "DM" or "COMMENT".
  kind         String  @default("DM")
  senderId     String
  inboundText  String
  intent       String
  handoff      Boolean @default(false)
  replyText    String
  status       String  @default("PENDING")
  errorMessage String?
  sentAt       DateTime?

  createdAt DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  /// Ordered for the per-account daily cap in the worker, which counts today's
  /// rows on every inbound DM. A bare instagramAccountId index would make that
  /// count scan the account's entire history as the table grows.
  @@index([instagramAccountId, createdAt])
  @@index([handoff])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
